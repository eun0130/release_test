{
  "manifest_version": 3,
  "name": "Atlas WBS",
  "version": "0.0.0",
  "description": "Atlas WBS Chrome extension with self-notifying GitHub release updates",
  "permissions": ["alarms", "storage"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {
    "service_worker": "app.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
